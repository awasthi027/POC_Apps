<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the SDK uploads events. localhost works in the iOS Simulator.
	     On a real iPhone use your Mac's address, e.g. http://192.168.1.20:8080/v1/analytics/events -->
	<key>AnalyticsEndpoint</key>
	<string>http://localhost:8080/v1/analytics/events</string>

	<!-- Lets the app use plain http to addresses on your local network (development only). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
